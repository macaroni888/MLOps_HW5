{
  "uid": "fraud-detection",
  "title": "Обработка транзакций",
  "schemaVersion": 38,
  "version": 4,
  "editable": true,
  "tags": [
    "fraud",
    "hw5"
  ],
  "timezone": "browser",
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Скорость потока",
      "type": "stat",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-metrics"
          },
          "editorMode": "code",
          "expr": "sum(rate(transactions_total[1m]))",
          "legendFormat": "",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 6,
      "title": "Время обработки",
      "type": "timeseries",
      "description": "Включая препроцессинг, inference и ожидание Kafka. Учитывает как успешные, так и неуспешные попытки",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-metrics"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(transaction_processing_duration_seconds_bucket[2m])))",
          "legendFormat": "p95",
          "range": true,
          "instant": false
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-metrics"
          },
          "editorMode": "code",
          "expr": "sum(rate(transaction_processing_duration_seconds_sum[2m])) / clamp_min(sum(rate(transaction_processing_duration_seconds_count[2m])), 0.000001)",
          "legendFormat": "Среднее",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "mean"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "title": "Доля фрода",
      "type": "stat",
      "description": "Доля срабатываний модели по заданному порогу",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-metrics"
          },
          "editorMode": "code",
          "expr": "fraud_ratio",
          "legendFormat": "",
          "range": false,
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ],
          "fields": ""
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "id": 7,
      "title": "Распределение скоров во времени",
      "type": "heatmap",
      "description": "Доля скоров в каждом из интервалов в промежуток в 30 секунд",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-metrics"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-metrics"
          },
          "editorMode": "code",
          "expr": "sum by (le) (increase(fraud_score_bucket[30s]))",
          "legendFormat": "{{le}}",
          "range": true,
          "instant": false,
          "format": "heatmap"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "calculate": false,
        "cellGap": 1,
        "color": {
          "mode": "scheme",
          "scheme": "Oranges",
          "steps": 64,
          "scale": "linear"
        },
        "yAxis": {
          "axisLabel": "Score",
          "min": 0,
          "max": 1
        },
        "legend": {
          "show": true
        },
        "tooltip": {
          "show": true,
          "yHistogram": false
        },
        "filterValues": {
          "le": 0
        }
      }
    },
    {
      "id": 8,
      "title": "Доля неуспешных обработок",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus-metrics"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus-metrics"
          },
          "editorMode": "code",
          "expr": "sum(rate(transaction_processing_errors_total[5m])) / (sum(rate(transactions_total[5m])) + sum(rate(transaction_processing_errors_total[5m])))",
          "legendFormat": "Ошибки за 5 минут",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    }
  ],
  "annotations": {
    "list": [
      {
        "name": "Модель переключена",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus-metrics"
        },
        "enable": true,
        "hide": false,
        "iconColor": "#FF9830",
        "expr": "(time() - model_reload_timestamp_seconds >= 0) and (time() - model_reload_timestamp_seconds < 30)",
        "step": "1s",
        "titleFormat": "Модель {{version}}",
        "textFormat": "Скоринг подхватил версию {{version}} без перезапуска."
      }
    ]
  }
}
